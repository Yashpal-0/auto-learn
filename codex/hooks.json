{
  "description": "Adds the skill guidance and the learned skills at session start and, after each eligible turn, starts a background skill review in a fork of the session.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/hook.mjs\" session-start --host=codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/hook.mjs\" stop --host=codex",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/hook.mjs\" session-end --host=codex",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
