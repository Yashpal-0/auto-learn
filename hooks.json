{
  "auto-learn": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./scripts/hook.mjs session-start --host=agy",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./scripts/hook.mjs stop --host=agy",
        "timeout": 30
      }
    ]
  }
}
